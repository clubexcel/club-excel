generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////
// ENUMS
//////////////////////

enum AchievementType {
  general
  competition
  hackathon
  certification
  award
}

enum EventStatus {
  upcoming
  completed
}

enum EventType {
  general
  sankalp
  workshop
  hackathon
}

enum RecruitmentPlatform {
  linkedin
  leetcode
  hackerank
  geeksforgeeks
  codechef
  codeforces
  github
  website
  other
}

enum Platform {
  whatsapp
  telegram
  discord
  linkedin
  twitter
  github
  instagram
  website
  other
}

enum ImageType {
  event
  gallery
  achievements
}

enum MemberCategory {
  alumni
  member
  advisor
}

enum Year {
  second
  third
  fourth
}

enum LinkType {
  member
  event
  recruitment
}

enum Gender {
  male
  female
  other
}

enum Locality {
  localite
  hostelite
}

enum RecruitmentType {
  recruitment
  event
  contact
}

//////////////////////
// MODELS
//////////////////////

model Achievement {
  id              String           @id @default(uuid())
  name            String
  description     String
  achievedAt      DateTime?
  achievementType AchievementType
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  images          EventImage[]
}

model Event {
  id                      String           @id @default(uuid())
  name                    String
  description             String
  eventDate               DateTime
  startTime               DateTime
  endTime                 DateTime
  venue                   String
  noOfAttendees           Int?
  status                  EventStatus
  rules                   String?
  registrationCloseAt     DateTime
  eventType               EventType
  capacity                Int
  maxTeamSize             Int?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  images                  EventImage[]
  links                   MemberLink[]
  recruitments            Recruitment[]
}

model EventImage {
  id            String      @id @default(uuid())
  imageUrl      String
  type          ImageType
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Polymorphic relations
  eventId       String?
  event         Event?      @relation(fields: [eventId], references: [id])

  galleryId     String?
  gallery       Gallery?    @relation(fields: [galleryId], references: [id])

  achievementId String?
  achievement   Achievement? @relation(fields: [achievementId], references: [id])
}

model Gallery {
  id          String       @id @default(uuid())
  groupName   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  images      EventImage[]
}

model Member {
  id          String          @id @default(uuid())
  name        String
  role        String
  color       String          @default("")
  img         String
  category    MemberCategory
  year        Year?
  section     String?
  platform    Platform
  bio         String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  links       MemberLink[]
}

model MemberLink {
  id                  String               @id @default(uuid())
  platform            Platform?
  recruitmentPlatform RecruitmentPlatform?
  link                String
  type                LinkType
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  // Polymorphic
  memberId      String?
  member        Member?     @relation(fields: [memberId], references: [id])

  eventId       String?
  event         Event?      @relation(fields: [eventId], references: [id])

  recruitmentId String?
  recruitment   Recruitment? @relation(fields: [recruitmentId], references: [id])
}

model Recruitment {
  id                     String          @id @default(uuid())
  name                   String
  rollNo                 String?
  instituteEmail         String?
  personalEmail          String
  gender                 Gender?
  branch                 String?
  phoneNo                String
  locality               Locality?
  techStack              String?
  isSelected             Boolean         @default(false)
  message                String?
  type                   RecruitmentType
  eventName              String?

  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  // Relations
  eventId                String?
  event                  Event?          @relation(fields: [eventId], references: [id])

  links                  MemberLink[]
}

model Admin {
  id          String    @id @default(uuid())
  name        String
  email       String    @unique
  password    String
  role        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Settings {
  id           String   @id @default(uuid())
  whatsappLink String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

